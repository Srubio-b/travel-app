# Public site URL used for metadata, sitemap and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key (public, safe for the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service_role key (server only — keep secret).
# Obtain from: Supabase Dashboard → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# WhatsApp number for contact buttons (international format, no +).
NEXT_PUBLIC_WHATSAPP_NUMBER=573001234567
